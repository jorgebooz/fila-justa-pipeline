# Copie para .env e ajuste: cp .env.example .env
# (nunca versione o .env)

# Linux: use o resultado de `id -u`. Mac/Windows: pode manter 50000.
AIRFLOW_UID=50000

# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=troque-esta-chave

# Login da UI do Airflow (http://localhost:8080)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Warehouse (PostgreSQL do projeto). Porta no host: 5433 (dentro do Docker é 5432)
WAREHOUSE_USER=fila_justa
WAREHOUSE_PASSWORD=troque-esta-senha
WAREHOUSE_DB=fila_justa
WAREHOUSE_PORT=5433
